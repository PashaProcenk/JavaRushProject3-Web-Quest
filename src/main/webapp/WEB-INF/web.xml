<web-app>
    <display-name>Web Quest</display-name>

    <servlet>
        <servlet-name>StartQuestServlet</servlet-name>
        <servlet-class>com.quest.servlets.StartQuestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StartQuestServlet</servlet-name>
        <url-pattern>/start</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Question1Servlet</servlet-name>
        <servlet-class>com.quest.servlets.Question1Servlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Question1Servlet</servlet-name>
        <url-pattern>/q1</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Question2Servlet</servlet-name>
        <servlet-class>com.quest.servlets.Question2Servlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Question2Servlet</servlet-name>
        <url-pattern>/q2</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Question3Servlet</servlet-name>
        <servlet-class>com.quest.servlets.Question3Servlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Question3Servlet</servlet-name>
        <url-pattern>/q3</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FinalServlet</servlet-name>
        <servlet-class>com.quest.servlets.FinalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FinalServlet</servlet-name>
        <url-pattern>/final</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>